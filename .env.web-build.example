# Copy this file to .env.web-build on the deployment host.
# NEXT_PUBLIC_* values are embedded into the browser bundle during
# `npm run build`.
NEXT_PUBLIC_APP_URL=
# Optional fallback used by metadata/origin helpers.
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_AI_SERVICE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_SHEET_ID=

# Two server modules validate these names while Next.js collects page data.
# These must remain fixed, nonfunctional build placeholders. The deployment
# script rejects real values here; production values remain runtime-only in
# .env.production.
SUPABASE_SERVICE_ROLE_KEY=build-time-placeholder-not-a-real-key
JWT_SECRET=build-time-placeholder-not-a-real-secret
